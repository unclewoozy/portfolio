{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && pip install -r requirements.txt",
  "buildCommand": "npm run build",
  "functions": {
    "backend/config/wsgi.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/admin(/.*)?", "dest": "/backend/config/wsgi.py" },
    { "src": "/api/.*", "dest": "/backend/config/wsgi.py" },
    { "src": "/media/.*", "dest": "/backend/config/wsgi.py" },
    { "src": "/health", "dest": "/backend/config/wsgi.py" },
    { "src": "/.*", "dest": "/backend/config/wsgi.py" }
  ]
}
